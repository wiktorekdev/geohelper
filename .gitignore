.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# env / secrets
.env
.env.*
!.env.example

# tauri signing keys - NEVER commit these
.tauri/
*.key
!capabilities/*.key

# runtime logs
logs/
*.log

# scratch
old/

