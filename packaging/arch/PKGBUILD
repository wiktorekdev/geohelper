# Maintainer: wiktorekdev
pkgname=geohelper-bin
pkgver=0.19.1
pkgrel=1
pkgdesc="GeoGuessr Steam helper"
arch=("x86_64")
url="https://github.com/wiktorekdev/geohelper"
license=("MIT")
depends=(
  "gtk3"
  "libayatana-appindicator"
  "librsvg"
  "libsoup3"
  "openssl"
  "webkit2gtk-4.1"
)
provides=("geohelper")
conflicts=("geohelper")
source=(
  "GeoHelper-${pkgver}-linux::${url}/releases/download/v${pkgver}/GeoHelper-${pkgver}-linux"
  "geohelper-icon.png::${url}/raw/v${pkgver}/src-tauri/icons/icon.png"
)
sha256sums=(
  "SKIP"
  "SKIP"
)

package() {
  install -Dm755 "GeoHelper-${pkgver}-linux" "${pkgdir}/usr/bin/geohelper"
  install -Dm644 "geohelper-icon.png" "${pkgdir}/usr/share/pixmaps/geohelper.png"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/geohelper.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=GeoHelper
Comment=GeoGuessr Steam helper
Exec=geohelper
Icon=geohelper
Terminal=false
Categories=Utility;
EOF
}
