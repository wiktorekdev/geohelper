{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    {
      "identifier": "opener:allow-open-url"
    },
    "updater:default",
    "process:allow-restart",
    "store:default"
  ]
}
